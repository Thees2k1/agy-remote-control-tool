{
  "mrc-lifecycle": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python hooks/session_start.py",
        "timeout": 15
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/pre_tool_use.py",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/post_tool_use.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
